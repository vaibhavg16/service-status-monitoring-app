import { sql } from "drizzle-orm";
import {
  boolean,
  index,
  integer,
  jsonb,
  pgEnum,
  pgTable,
  real,
  serial,
  text,
  timestamp,
  uniqueIndex,
} from "drizzle-orm/pg-core";

export const userRole = pgEnum("user_role", ["merchant", "admin"]);
export const aspect = pgEnum("aspect", ["up", "degraded", "down"]);
export const channel = pgEnum("channel", ["telegram", "sms", "whatsapp"]);
export const reportState = pgEnum("report_state", [
  "open",
  "confirmed",
  "withdrawn",
  "dismissed",
]);
export const incidentState = pgEnum("incident_state", [
  "investigating",
  "identified",
  "resolved",
]);
export const outboxState = pgEnum("outbox_state", ["queued", "sent", "failed"]);

export const users = pgTable(
  "users",
  {
    id: serial("id").primaryKey(),
    email: text("email").notNull().unique(),
    passwordHash: text("password_hash").notNull(),
    name: text("name").notNull(),
    role: userRole("role").notNull().default("merchant"),
    city: text("city").notNull().default("Pune"),
    locale: text("locale").notNull().default("en"),
    telegramId: text("telegram_id"),
    telegramHandle: text("telegram_handle"),
    phone: text("phone"),
    createdAt: timestamp("created_at", { withTimezone: true })
      .notNull()
      .defaultNow(),
  },
  (t) => [
    index("users_role_idx").on(t.role),
    uniqueIndex("users_telegram_id_uq").on(t.telegramId),
  ],
);

export const services = pgTable(
  "services",
  {
    id: serial("id").primaryKey(),
    slug: text("slug").notNull().unique(),
    name: text("name").notNull(),
    shortName: text("short_name").notNull(),
    category: text("category").notNull().default("payments"),
    provider: text("provider").notNull(),
    url: text("url").notNull(),
    description: text("description").notNull().default(""),
    baseLatencyMs: integer("base_latency_ms").notNull().default(220),
    checkIntervalSec: integer("check_interval_sec").notNull().default(30),
    timeoutMs: integer("timeout_ms").notNull().default(5000),
    degradedThresholdMs: integer("degraded_threshold_ms").notNull().default(900),
    downThresholdMs: integer("down_threshold_ms").notNull().default(3000),
    paused: boolean("paused").notNull().default(false),
    sortOrder: integer("sort_order").notNull().default(0),
    createdAt: timestamp("created_at", { withTimezone: true })
      .notNull()
      .defaultNow(),
  },
  (t) => [index("services_sort_idx").on(t.sortOrder)],
);

export const probeResults = pgTable(
  "probe_results",
  {
    id: serial("id").primaryKey(),
    serviceId: integer("service_id")
      .notNull()
      .references(() => services.id, { onDelete: "cascade" }),
    checkedAt: timestamp("checked_at", { withTimezone: true })
      .notNull()
      .defaultNow(),
    latencyMs: integer("latency_ms").notNull(),
    success: boolean("success").notNull(),
    status: aspect("status").notNull(),
    source: text("source").notNull().default("probe"),
    detail: text("detail"),
  },
  (t) => [
    index("probe_service_time_idx").on(t.serviceId, t.checkedAt),
    index("probe_time_idx").on(t.checkedAt),
  ],
);

export const reports = pgTable(
  "reports",
  {
    id: serial("id").primaryKey(),
    serviceId: integer("service_id")
      .notNull()
      .references(() => services.id, { onDelete: "cascade" }),
    userId: integer("user_id").references(() => users.id, {
      onDelete: "set null",
    }),
    city: text("city").notNull().default("—"),
    note: text("note").notNull().default(""),
    state: reportState("state").notNull().default("open"),
    createdAt: timestamp("created_at", { withTimezone: true })
      .notNull()
      .defaultNow(),
    withdrawnAt: timestamp("withdrawn_at", { withTimezone: true }),
  },
  (t) => [
    index("reports_service_time_idx").on(t.serviceId, t.createdAt),
    index("reports_user_idx").on(t.userId),
  ],
);

export const subscriptions = pgTable(
  "subscriptions",
  {
    id: serial("id").primaryKey(),
    userId: integer("user_id")
      .notNull()
      .references(() => users.id, { onDelete: "cascade" }),
    serviceId: integer("service_id")
      .notNull()
      .references(() => services.id, { onDelete: "cascade" }),
    channel: channel("channel").notNull().default("telegram"),
    minSeverity: aspect("min_severity").notNull().default("degraded"),
    active: boolean("active").notNull().default(true),
    createdAt: timestamp("created_at", { withTimezone: true })
      .notNull()
      .defaultNow(),
  },
  (t) => [
    uniqueIndex("subs_user_service_channel_uq").on(
      t.userId,
      t.serviceId,
      t.channel,
    ),
    index("subs_service_idx").on(t.serviceId),
  ],
);

export const incidents = pgTable(
  "incidents",
  {
    id: serial("id").primaryKey(),
    serviceId: integer("service_id")
      .notNull()
      .references(() => services.id, { onDelete: "cascade" }),
    title: text("title").notNull(),
    severity: aspect("severity").notNull().default("degraded"),
    state: incidentState("state").notNull().default("investigating"),
    startedAt: timestamp("started_at", { withTimezone: true })
      .notNull()
      .defaultNow(),
    resolvedAt: timestamp("resolved_at", { withTimezone: true }),
    cause: text("cause").notNull().default("Cause under observation"),
    origin: text("origin").notNull().default("probe"),
    autoClosed: boolean("auto_closed").notNull().default(false),
    createdBy: integer("created_by").references(() => users.id, {
      onDelete: "set null",
    }),
  },
  (t) => [index("incidents_service_time_idx").on(t.serviceId, t.startedAt)],
);

export const incidentEvents = pgTable(
  "incident_events",
  {
    id: serial("id").primaryKey(),
    incidentId: integer("incident_id")
      .notNull()
      .references(() => incidents.id, { onDelete: "cascade" }),
    at: timestamp("at", { withTimezone: true })
      .notNull()
      .defaultNow(),
    kind: text("kind").notNull().default("note"),
    body: text("body").notNull(),
    author: text("author").notNull().default("system"),
  },
  (t) => [index("incident_events_idx").on(t.incidentId, t.at)],
);

export const outbox = pgTable(
  "outbox",
  {
    id: serial("id").primaryKey(),
    userId: integer("user_id").references(() => users.id, {
      onDelete: "cascade",
    }),
    subscriptionId: integer("subscription_id").references(
      () => subscriptions.id,
      { onDelete: "cascade" },
    ),
    serviceId: integer("service_id").references(() => services.id, {
      onDelete: "cascade",
    }),
    channel: channel("channel").notNull().default("telegram"),
    title: text("title").notNull(),
    body: text("body").notNull(),
    severity: aspect("severity").notNull().default("degraded"),
    state: outboxState("state").notNull().default("queued"),
    detail: text("detail"),
    attempts: integer("attempts").notNull().default(0),
    target: text("target").notNull().default(""),
    createdAt: timestamp("created_at", { withTimezone: true })
      .notNull()
      .defaultNow(),
    sentAt: timestamp("sent_at", { withTimezone: true }),
  },
  (t) => [index("outbox_state_idx").on(t.state, t.createdAt)],
);

export const appComponents = pgTable(
  "app_components",
  {
    id: serial("id").primaryKey(),
    slug: text("slug").notNull().unique(),
    name: text("name").notNull(),
    description: text("description").notNull().default(""),
    state: aspect("state").notNull().default("up"),
    uptime7d: real("uptime7d").notNull().default(99.9),
    meta: jsonb("meta").$type<Record<string, string>>().default({}),
    updatedAt: timestamp("updated_at", { withTimezone: true })
      .notNull()
      .defaultNow(),
  },
  (t) => [index("app_components_slug_idx").on(t.slug)],
);

export const schemaVersion = pgTable("schema_version", {
  id: serial("id").primaryKey(),
  note: text("note").notNull(),
  appliedAt: timestamp("applied_at", { withTimezone: true })
    .notNull()
    .defaultNow(),
  hash: text("hash")
    .notNull()
    .default(sql`gen_random_uuid()::text`),
});
