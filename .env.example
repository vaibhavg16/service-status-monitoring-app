/**
 * Environment variables for the live Telegram + WhatsApp alert path.
 * Copy to .env and fill in. NEXT_PUBLIC_* values are baked into the browser
 * bundle, so never put secrets behind that prefix.
 */

# --- core -------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# long random string; signs session cookies and Telegram link tokens
AUTH_SECRET=replace-with-64-random-chars

# --- hot status cache (optional but recommended) -----------------------------
REDIS_URL=redis://127.0.0.1:6379

# --- probe worker -----------------------------------------------------------
PROBE_INTERVAL_MS=30000
# set to 1 to stop the in-process probe worker (use /api/cron/tick instead)
DISABLE_PROBE_WORKER=

# --- Telegram ---------------------------------------------------------------
# 1. from @BotFather -> /newbot
TELEGRAM_BOT_TOKEN=123456:AA...your-bot-token
# 2. the bot's username WITHOUT the @ (renders the Login Widget)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=isitdownindia_bot
# 3. any string you choose; passed to setWebhook and checked on every update
TELEGRAM_WEBHOOK_SECRET=replace-with-32-random-chars

# --- WhatsApp Cloud API (Meta) ---------------------------------------------
WHATSAPP_TOKEN=EAAG...permanent-system-user-token
WHATSAPP_PHONE_ID=1234567890
WHATSAPP_TEMPLATE=status_alert
WHATSAPP_VERIFY_TOKEN=replace-with-32-random-chars

# --- scheduled ticks (serverless hosts) -------------------------------------
# protects POST /api/cron/tick ; send as ?key=... or Authorization: Bearer ...
CRON_SECRET=replace-with-32-random-chars
